# Copy to .env and fill in. `flask` auto-loads .env via python-dotenv.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///ctbrx.db

# osu! OAuth client (https://osu.ppy.sh/home/account/edit -> "OAuth" -> "New OAuth Application").
# Callback URL can be anything (e.g. http://localhost) - client-credentials grant doesn't use it.
OSU_CLIENT_ID=0
OSU_CLIENT_SECRET=

# Ingestion. ENABLE_INGEST=1 turns on the background scheduler; it then starts
# automatically under `flask run`. Under waitress/gunicorn also set RUN_SCHEDULER=1.
ENABLE_INGEST=0
# RUN_SCHEDULER=1
OSU_API_INTERVAL=0.75
FIREHOSE_INTERVAL=5
USER_REFRESH_INTERVAL=3600
CLEANUP_INTERVAL=1800
FIREHOSE_BACKFILL=200000

BEATMAP_CACHE=beatmapcache

SITE_NAME=CTBRX
DISCORD_URL=
